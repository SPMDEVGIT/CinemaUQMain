<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      styleClass="contenido" spacing="12"
      fx:controller="co.edu.uniquindio.cinemauq.controladores.FuncionesControlador">
    <Label text="Funciones programadas" styleClass="titulo-seccion"/>
    <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colCodigo" text="Código"/>
            <TableColumn fx:id="colPelicula" text="Película"/>
            <TableColumn fx:id="colSala" text="Sala"/>
            <TableColumn fx:id="colFecha" text="Fecha"/>
            <TableColumn fx:id="colHora" text="Hora"/>
            <TableColumn fx:id="colValor" text="Valor"/>
            <TableColumn fx:id="colDisponibles" text="Asientos disponibles"/>
        </columns>
    </TableView>
</VBox>
