<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      styleClass="contenido" spacing="12"
      fx:controller="co.edu.uniquindio.cinemauq.controladores.GestionSalasControlador">
    <Label text="Gestión de salas" styleClass="titulo-seccion"/>
    <Label text="Selecciona una fila de la tabla para modificarla. El código no se puede cambiar."
           styleClass="ayuda"/>
    <GridPane hgap="10" vgap="8">
        <Label text="Código" styleClass="etiqueta" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="txtCodigo" prefWidth="200" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <Label text="Nombre" styleClass="etiqueta" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
        <TextField fx:id="txtNombre" prefWidth="260" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
        <Label text="Filas (1 a 26)" styleClass="etiqueta" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="txtFilas" prefWidth="200" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <Label text="Asientos por fila" styleClass="etiqueta" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
        <TextField fx:id="txtAsientosPorFila" prefWidth="260" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
    </GridPane>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button fx:id="btnGuardar" text="Registrar" onAction="#guardar" styleClass="boton-primario"/>
        <Button text="Nuevo" onAction="#nuevo" styleClass="boton-neutro"/>
        <Button text="Deshabilitar" onAction="#deshabilitar" styleClass="boton-peligro"/>
        <Button text="Habilitar" onAction="#habilitar" styleClass="boton-neutro"/>
    </HBox>
    <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colCodigo" text="Código"/>
            <TableColumn fx:id="colNombre" text="Nombre"/>
            <TableColumn fx:id="colFilas" text="Filas"/>
            <TableColumn fx:id="colAsientosPorFila" text="Asientos por fila"/>
            <TableColumn fx:id="colCapacidad" text="Capacidad"/>
            <TableColumn fx:id="colEstado" text="Estado"/>
        </columns>
    </TableView>
</VBox>
