<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      styleClass="contenido" spacing="12"
      fx:controller="co.edu.uniquindio.cinemauq.controladores.ClientesControlador">
    <Label text="Clientes" styleClass="titulo-seccion"/>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Identificación" styleClass="etiqueta"/>
        <TextField fx:id="txtIdentificacion" prefWidth="170"/>
        <Label text="Nombre" styleClass="etiqueta"/>
        <TextField fx:id="txtNombre" prefWidth="240"/>
        <Label text="Tipo" styleClass="etiqueta"/>
        <ComboBox fx:id="cmbTipo" prefWidth="170" promptText="Selecciona"/>
        <Button text="Registrar" onAction="#registrar" styleClass="boton-primario"/>
    </HBox>
    <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colIdentificacion" text="Identificación"/>
            <TableColumn fx:id="colNombre" text="Nombre"/>
            <TableColumn fx:id="colTipo" text="Tipo"/>
        </columns>
    </TableView>
</VBox>
