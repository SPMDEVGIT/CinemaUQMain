<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      styleClass="contenido" spacing="12"
      fx:controller="co.edu.uniquindio.cinemauq.controladores.TarifasControlador">
    <Label text="Tarifas" styleClass="titulo-seccion"/>
    <Label text="Selecciona un tipo de cliente de la tabla para cambiar su porcentaje de descuento. Las ventas ya hechas no cambian."
           styleClass="ayuda"/>
    <TableView fx:id="tabla" prefHeight="190" maxHeight="190">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colTipo" text="Tipo de cliente"/>
            <TableColumn fx:id="colPorcentaje" text="Descuento"/>
        </columns>
    </TableView>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Tipo" styleClass="etiqueta"/>
        <Label fx:id="lblTipo" styleClass="dato-destacado" minWidth="120"/>
        <Label text="Nuevo descuento (%)" styleClass="etiqueta"/>
        <TextField fx:id="txtPorcentaje" prefWidth="100"/>
        <Button text="Modificar" onAction="#modificar" styleClass="boton-primario"/>
    </HBox>
</VBox>
