<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      styleClass="contenido" spacing="12"
      fx:controller="co.edu.uniquindio.cinemauq.controladores.VenderControlador">
    <Label text="Vender entrada" styleClass="titulo-seccion"/>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Función" styleClass="etiqueta" minWidth="70"/>
        <ComboBox fx:id="cmbFunciones" prefWidth="560" promptText="Selecciona una función"/>
    </HBox>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Cliente" styleClass="etiqueta" minWidth="70"/>
        <TextField fx:id="txtIdentificacion" promptText="Identificación del cliente" prefWidth="240"/>
        <Button text="Buscar" onAction="#buscarCliente" styleClass="boton-primario"/>
        <Label fx:id="lblCliente" styleClass="dato-destacado"/>
    </HBox>
    <ScrollPane fx:id="scrollMapa" fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="panel-mapa"/>
    <HBox spacing="24" alignment="CENTER_LEFT">
        <Label fx:id="lblAsiento" styleClass="dato-destacado"/>
        <Label fx:id="lblValor" styleClass="valor-pagar"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Confirmar venta" onAction="#confirmarVenta" styleClass="boton-primario"/>
    </HBox>
</VBox>
