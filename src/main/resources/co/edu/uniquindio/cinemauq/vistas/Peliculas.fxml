<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      styleClass="contenido" spacing="12"
      fx:controller="co.edu.uniquindio.cinemauq.controladores.PeliculasControlador">
    <Label text="Películas disponibles" styleClass="titulo-seccion"/>
    <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colNombre" text="Nombre"/>
            <TableColumn fx:id="colGenero" text="Género"/>
            <TableColumn fx:id="colDuracion" text="Duración (min)"/>
            <TableColumn fx:id="colClasificacion" text="Clasificación"/>
        </columns>
    </TableView>
</VBox>
