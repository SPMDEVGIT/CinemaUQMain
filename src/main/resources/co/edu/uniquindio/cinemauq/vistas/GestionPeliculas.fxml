<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      styleClass="contenido" spacing="12"
      fx:controller="co.edu.uniquindio.cinemauq.controladores.GestionPeliculasControlador">
    <Label text="Gestión de películas" styleClass="titulo-seccion"/>
    <Label text="Selecciona una fila de la tabla para modificarla. El código no se puede cambiar."
           styleClass="ayuda"/>
    <GridPane hgap="10" vgap="8">
        <Label text="Código" styleClass="etiqueta" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="txtCodigo" prefWidth="200" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <Label text="Nombre" styleClass="etiqueta" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
        <TextField fx:id="txtNombre" prefWidth="260" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
        <Label text="Género" styleClass="etiqueta" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <ComboBox fx:id="cmbGenero" prefWidth="200" promptText="Selecciona"
                  GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <Label text="Duración (min)" styleClass="etiqueta" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
        <TextField fx:id="txtDuracion" prefWidth="260" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
        <Label text="Clasificación" styleClass="etiqueta" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <ComboBox fx:id="cmbClasificacion" prefWidth="200" promptText="Selecciona"
                  GridPane.columnIndex="1" GridPane.rowIndex="2"/>
    </GridPane>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button fx:id="btnGuardar" text="Registrar" onAction="#guardar" styleClass="boton-primario"/>
        <Button text="Nuevo" onAction="#nuevo" styleClass="boton-neutro"/>
        <Button text="Deshabilitar" onAction="#deshabilitar" styleClass="boton-peligro"/>
    </HBox>
    <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colCodigo" text="Código"/>
            <TableColumn fx:id="colNombre" text="Nombre"/>
            <TableColumn fx:id="colGenero" text="Género"/>
            <TableColumn fx:id="colDuracion" text="Duración"/>
            <TableColumn fx:id="colClasificacion" text="Clasificación"/>
            <TableColumn fx:id="colEstado" text="Estado"/>
        </columns>
    </TableView>
</VBox>
