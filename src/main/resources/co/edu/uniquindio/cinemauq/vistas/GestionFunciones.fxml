<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      styleClass="contenido" spacing="12"
      fx:controller="co.edu.uniquindio.cinemauq.controladores.GestionFuncionesControlador">
    <Label text="Gestión de funciones" styleClass="titulo-seccion"/>
    <GridPane hgap="10" vgap="8">
        <Label text="Película" styleClass="etiqueta" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <ComboBox fx:id="cmbPelicula" prefWidth="260" promptText="Selecciona"
                  GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <Label text="Sala" styleClass="etiqueta" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
        <ComboBox fx:id="cmbSala" prefWidth="260" promptText="Selecciona"
                  GridPane.columnIndex="3" GridPane.rowIndex="0"/>
        <Label text="Fecha" styleClass="etiqueta" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <DatePicker fx:id="dpFecha" prefWidth="260" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <Label text="Hora (HH:mm)" styleClass="etiqueta" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
        <TextField fx:id="txtHora" prefWidth="260" promptText="Ej. 18:30"
                   GridPane.columnIndex="3" GridPane.rowIndex="1"/>
        <Label text="Valor base" styleClass="etiqueta" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="txtValor" prefWidth="260" promptText="Ej. 15000"
                   GridPane.columnIndex="1" GridPane.rowIndex="2"/>
    </GridPane>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button text="Programar función" onAction="#programar" styleClass="boton-primario"/>
        <Button text="Finalizar seleccionada" onAction="#finalizar" styleClass="boton-neutro"/>
        <Button text="Cancelar seleccionada" onAction="#cancelar" styleClass="boton-peligro"/>
    </HBox>
    <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colCodigo" text="Código"/>
            <TableColumn fx:id="colPelicula" text="Película"/>
            <TableColumn fx:id="colSala" text="Sala"/>
            <TableColumn fx:id="colFecha" text="Fecha"/>
            <TableColumn fx:id="colHora" text="Hora"/>
            <TableColumn fx:id="colValor" text="Valor base"/>
            <TableColumn fx:id="colEstado" text="Estado"/>
        </columns>
    </TableView>
</VBox>
